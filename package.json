{
  "name": "dealfold",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd apps/api && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm --prefix apps/web run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}